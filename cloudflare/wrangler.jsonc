{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "procreators",
  "main": "src/index.js",
  "compatibility_date": "2026-10-28",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "ProCreatorsApp",
      // Built from the repo root so the Dockerfile sees the whole app.
      "image": "../Dockerfile",
      "image_build_context": "..",
      // Next.js + Chromium + ffmpeg need real memory; 1 vCPU / 6 GiB / 12 GB disk.
      "instance_type": "standard-2",
      // One instance only: rate limits and generated files live in the process (see src/index.js).
      "max_instances": 1,
      // Docker build args. Next.js inlines NEXT_PUBLIC_* at build time, so set them here, then redeploy.
      "image_vars": {
        "NEXT_PUBLIC_BASE_URL": "https://procreators.its4shamim.workers.dev",
        "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY": ""
      }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "APP", "class_name": "ProCreatorsApp" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProCreatorsApp"] }],
  // Non-secret settings. Put API keys in with `npx wrangler secret put NAME` (see DEPLOY.md).
  "vars": {
    "NODE_ENV": "production",
    // The container is only reachable through this Worker, so CF-Connecting-IP can be trusted.
    "BEHIND_CLOUDFLARE": "true"
  }
}
