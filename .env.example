# Copy to .env (local) or set these in your host's secret manager. Never commit real values.
# Required to build: RESEND_API_KEY (the build fails without it, see app/api/contact/route.js).

# --- Core ---
NEXT_PUBLIC_BASE_URL=https://your-domain.example
MONGO_URL=
DB_NAME=
CORS_ORIGINS=
SALT=
CSRF_SECRET=
CRON_SECRET=

# --- Container / hosting ---
# BEHIND_CLOUDFLARE=true trusts CF-Connecting-IP for rate limiting. Only set it if the origin
# accepts traffic from Cloudflare alone, otherwise clients can spoof that header.
BEHIND_CLOUDFLARE=false
# Space-separated frame-ancestors list. Default is same-origin only.
# FRAME_ANCESTORS='self' https://partner.example
# PUBLIC_DIR=/app/public
# DATA_DIR=/data

# --- AI ---
GOOGLE_API_KEY=
# GEMINI_TEXT_MODEL=gemini-2.5-flash
GOOGLE_APPLICATION_CREDENTIALS=
FAL_KEY=
REPLICATE_API_TOKEN=
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=

# --- Media ---
PEXELS_API_KEY=
PIXABAY_API_KEY=
FREESOUND_API_KEY=

# --- Payments (Stripe) ---
STRIPE_API_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Required in production: the webhook returns 503 without it.
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_2=

# --- Email ---
RESEND_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
FROM_EMAIL=
CONTACT_EMAIL=

# --- Storage (Cloudflare R2, S3 API) ---
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# --- Optional ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
